# smart-meal-planner/backend/.env.staging

# Core Application Settings
ENVIRONMENT="staging"
SECRET_KEY="<generate_a_strong_secret_key_for_staging>"
USE_SQLITE_LOCAL="False"

# Database Configuration
DATABASE_URL="postgresql://<staging_user>:<staging_password>@<staging_host>:<port>/<staging_db>"

# Redis Configuration
REDIS_URL="redis://<staging_redis_host>:6379/0"

# AI Service (OpenRouter)
USE_MOCK_AI="False"
OPENROUTER_API_KEY="<your_openrouter_api_key>"

# External Services
SENTRY_DSN="<your_sentry_dsn_for_staging>"

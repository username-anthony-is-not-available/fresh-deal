# smart-meal-planner/backend/.env.production

# Core Application Settings
ENVIRONMENT="production"
SECRET_KEY="<generate_a_strong_secret_key_for_production>"
USE_SQLITE_LOCAL="False"

# Database Configuration
DATABASE_URL="postgresql://<prod_user>:<prod_password>@<prod_host>:<port>/<prod_db>"

# Redis Configuration
REDIS_URL="redis://<prod_redis_host>:6379/0"

# AI Service (OpenRouter)
USE_MOCK_AI="False"
OPENROUTER_API_KEY="<your_openrouter_api_key>"

# External Services
SENTRY_DSN="<your_sentry_dsn_for_production>"

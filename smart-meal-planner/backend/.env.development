# smart-meal-planner/backend/.env.development

# Core Application Settings
ENVIRONMENT="development"
SECRET_KEY="a_very_secret_key" # OK for development
USE_SQLITE_LOCAL="True" # Use SQLite for local dev
DISABLE_PROXIES_LOCAL="True" # Bypass external proxies locally with polite jitter

# Local Postal Code for Quebec flyers
LOCAL_POSTAL_CODE="H4T1V6"
DEFAULT_POSTAL_CODE="H4T1V6"

# Database Configuration (Ignored when USE_SQLITE_LOCAL is True)
# DATABASE_URL=
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=mealplanner_dev

# Redis Configuration (Ignored in Celery Eager local mode)
REDIS_URL="redis://localhost:6379/0"

# AI Service (Local Ollama / OpenRouter / Mock)
USE_MOCK_AI="True" # Use mock AI to avoid API calls in dev
OPENROUTER_API_KEY="" # Not required when using mock AI or local Ollama
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Shopping & Store-hopping Optimization
MAX_STORES_PER_TRIP=2
TRAVEL_COST_PER_STOP=3.50

# External Services
SENTRY_DSN="" # Optional: Add a Sentry DSN for development if needed

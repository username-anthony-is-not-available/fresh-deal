# smart-meal-planner/backend/.env.development

# Core Application Settings
ENVIRONMENT="development"
SECRET_KEY="a_very_secret_key" # OK for development
USE_SQLITE_LOCAL="True" # Use SQLite for local dev

# Database Configuration (Ignored when USE_SQLITE_LOCAL is True)
# DATABASE_URL=
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=mealplanner_dev

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# AI Service (OpenRouter)
USE_MOCK_AI="True" # Use mock AI to avoid API calls in dev
OPENROUTER_API_KEY="" # Not required when using mock AI

# External Services
SENTRY_DSN="" # Optional: Add a Sentry DSN for development if needed

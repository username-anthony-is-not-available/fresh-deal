# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------

# Secret key for signing JWTs.
# It is recommended to use a long, random string.
# You can generate one using: openssl rand -hex 32
SECRET_KEY="a_very_secret_key"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Set to "True" to use a local SQLite database for development instead of PostgreSQL.
USE_SQLITE_LOCAL="False"

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Option 1: Provide a full database connection string.
# If this is set, it will override the individual PostgreSQL variables below.
# Example for PostgreSQL: DATABASE_URL="postgresql://user:password@host:port/dbname"
# Example for SQLite: DATABASE_URL="sqlite:///./test.db"
DATABASE_URL=

# Option 2: Provide individual PostgreSQL connection details.
# These are ignored if DATABASE_URL is set.
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mealplanner

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Used for caching and background tasks.
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# AI Service (OpenRouter)
# -----------------------------------------------------------------------------
# API key for OpenRouter.ai, used for meal plan generation.
# Get one from https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Set to "True" to use a mock AI service for development, avoiding API calls.
USE_MOCK_AI="False"

# Optional: Override default OpenRouter models.
# See https://openrouter.ai/models for available models.
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# DEFAULT_MODEL="meta-llama/llama-3.1-8b-instruct:free"
# FALLBACK_MODEL="meta-llama/llama-3.1-8b-instruct:free"
# OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking.
# If provided, errors and exceptions will be sent to Sentry.
SENTRY_DSN=""

# FatSecret API credentials for nutritional information.
FATSECRET_API_KEY=""
FATSECRET_API_SECRET=""

# Edamam API credentials for nutritional information.
EDAMAM_APP_ID=""
EDAMAM_APP_KEY=""
